      "default": 10.0,
      "min": -500.0,
      "max": 500.0,
      "unit": "pixels",
      "description": "Maximum horizontal pixel deflection corresponding to a full channel variance."
    },
    {
      "id": "MaxVerticalDisplacement",
      "slot": "inputs.1",
      "type": "double",
      "aeName": "Max Vertical Displacement",
      "default": 10.0,
      "min": -500.0,
      "max": 500.0,
      "unit": "pixels",
      "description": "Maximum vertical pixel deflection corresponding to a full channel variance."
    },
    {

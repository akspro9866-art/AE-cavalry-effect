      "slot": "inputs.2",
      "type": "double",
      "aeName": "Use For Horizontal Displacement",
      "default": 0.0,
      "options": [
        { "value": 0, "label": "Red" },
        { "value": 1, "label": "Green" },
        { "value": 2, "label": "Blue" },
        { "value": 3, "label": "Alpha" },
        { "value": 4, "label": "Luminance" },
        { "value": 5, "label": "Lightness" },
        { "value": 6, "label": "Off" }
      ],
      "description": "Color channel used to drive horizontal coordinate deflection."
    },
    {
      "id": "VerticalSourceChannel",
      "slot": "inputs.3",
      "type": "double",
      "aeName": "Use For Vertical Displacement",
      "default": 1.0,
      "options": [
        { "value": 0, "label": "Red" },
        { "value": 1, "label": "Green" },
        { "value": 2, "label": "Blue" },
        { "value": 3, "label": "Alpha" },
        { "value": 4, "label": "Luminance" },
        { "value": 5, "label": "Lightness" },
        { "value": 6, "label": "Off" }
      ],
      "description": "Color channel used to drive vertical coordinate deflection."
    },

{
  "effectSlug": "displacement-map",
  "aeName": "Displacement Map",
  "aeMatchName": "ADBE Displacement Map",
  "aeCategory": "Distort",
  "provenanceNote": "Reconstructs Adobe After Effects Displacement Map (ADBE Displacement Map) using channel-selective coordinate deflection, boundary wrapping, and dynamic secondary map layer connections.",

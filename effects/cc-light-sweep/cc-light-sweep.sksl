// Adobe After Effects "CC Light Sweep" (CC Light Sweep)
// Reconstructed mathematically for Cavalry 2.8+ as a high-performance GPU SkSL Filter (`skslFilter`).
//
// Built-in Cavalry preamble uniforms (injected automatically by Cavalry runtime):
//   `layer` (uniform shader) - Source layer texture sampler (layer.eval(coords))
//   `resolution` (float2)   - Bounding dimensions in pixels (centered coordinate space)

uniform shader layer;

// Dynamic attribute uniforms (mapped to Cavalry `inputs.0`..`inputs.8`):
uniform float CenterX;         // X coordinate of light sweep center (default: 0.0)
uniform float CenterY;         // Y coordinate of light sweep center (default: 0.0)
uniform float Direction;       // Sweep band angle in degrees (default: 30.0, range: -360.0 to 360.0)
uniform float Shape;           // 0 = Linear, 1 = Smooth, 2 = Sharp
uniform float Width;           // Width of the light band in pixels (default: 50.0, range: 1.0 to 500.0)
uniform float SweepIntensity;  // Center light band intensity (default: 1.0, range: 0.0 to 10.0)
uniform float EdgeIntensity;   // Edge bevel specular intensity (default: 2.0, range: 0.0 to 10.0)
uniform float EdgeThickness;   // Edge detection sampling radius (default: 4.0, range: 0.0 to 50.0)
uniform half4 LightColor;      // Color swatch of the sweeping beam (default: RGB(255, 255, 255))

half4 main(float2 fragCoord) {
    half4 src = layer.eval(fragCoord);
    if (src.a <= 0.0001) {
        return src;
    }

    float rad = Direction * 0.017453292519943295;
    // Normal perpendicular to sweep direction
    float2 normal = float2(-sin(rad), cos(rad));
    float2 center = float2(CenterX, CenterY);

    float d = abs(dot(fragCoord - center, normal));
    float halfW = max(Width * 0.5, 0.5);

    float beam = 0.0;
    if (d < halfW) {
        float u = 1.0 - (d / halfW);
        int shp = int(floor(Shape + 0.5));
        if (shp == 1) {
            // Smoothstep
            beam = u * u * (3.0 - 2.0 * u);
        } else if (shp == 2) {
            // Sharp
            beam = u * u * u;
        } else {
            // Linear
            beam = u;
        }
    }

    // Alpha gradient for edge bevel highlight
    float eps = max(EdgeThickness, 1.0);
    float aRight = float(layer.eval(fragCoord + float2(eps, 0.0)).a);
    float aLeft  = float(layer.eval(fragCoord - float2(eps, 0.0)).a);
    float aUp    = float(layer.eval(fragCoord + float2(0.0, eps)).a);
    float aDown  = float(layer.eval(fragCoord - float2(0.0, eps)).a);

    float2 grad = float2(aRight - aLeft, aUp - aDown);
    float edgeFactor = length(grad) * 0.5;

    float lightContrib = (beam * SweepIntensity + edgeFactor * beam * EdgeIntensity);
    half3 lightRgb = LightColor.rgb * half(lightContrib);

    // Composite additively over source within alpha silhouette
    float alpha = float(src.a);
    half3 outRgb = clamp(src.rgb + lightRgb * half(alpha), half3(0.0), half3(1.0));

    return half4(outRgb, src.a);
}
